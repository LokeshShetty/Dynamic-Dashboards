{
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "all",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react$",
    "^react-dom(/.*)?$",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/(?!.*\\.css$).*$",
    "",
    "^[./].*(?<!\\.css)$",
    "",
    ".*\\.css$"
  ],
  "importOrderTypeScriptVersion": "5.0.0"
}
