    {
      "id": "reading-note",
      "kind": "text",
      "title": "How to read this",
      "layout": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 1
      },
      "body": "Figures cover the selected filters only. A widget that cannot reach its data says so on the tile instead of showing a stale number.\n\n- **Stale** means the numbers are old and the refresh failed.\n- **Unresolvable** means the configuration points at something the dataset no longer has.",
      "tone": "note"
    }
  ]
