{
  "schemaVersion": 3,
  "id": "hostile",
  "title": "Layouts that cannot be placed",
  "version": 1,
  "dataset": "claims",
  "layout": { "columns": 12 },
  "filters": [],
  "widgets": [
    {
      "id": "negative",
      "kind": "metric",
      "title": "Negative x",
      "layout": { "x": -1, "y": 0, "w": 3, "h": 1 },
      "value": { "field": "amount_cents", "aggregate": "sum" }
    },
    {
      "id": "infinite",
      "kind": "metric",
      "title": "Infinite width",
      "layout": { "x": 0, "y": 1, "w": 1e999, "h": 1 },
      "value": { "field": "amount_cents", "aggregate": "sum" }
    },
    {
      "id": "fractional",
      "kind": "metric",
      "title": "Fractional height",
      "layout": { "x": 0, "y": 2, "w": 3, "h": 2.5 },
      "value": { "field": "amount_cents", "aggregate": "sum" }
    },
    {
      "id": "stringy",
      "kind": "metric",
      "title": "String coordinate",
      "layout": { "x": "3", "y": 3, "w": 3, "h": 1 },
      "value": { "field": "amount_cents", "aggregate": "sum" }
    }
  ]
}
