{
  "schemaVersion": 2,
  "id": "demo",
  "title": "Claims operations",
  "version": 4,
  "updatedAt": "2026-09-01T09:00:00.000Z",
  "dataset": "claims",
  "layout": { "columns": 12 },
  "filters": [
    {
      "id": "status",
      "kind": "select",
      "label": "Status",
      "field": "status",
      "options": [
        { "value": "submitted", "label": "Submitted" },
        { "value": "in_review", "label": "In review" },
        { "value": "paid", "label": "Paid" },
        { "value": "denied", "label": "Denied" },
        { "value": "appealed", "label": "Appealed" }
      ]
    },
    {
      "id": "payer",
      "kind": "multi-select",
      "label": "Payer",
      "field": "payer",
      "options": [
        { "value": "Meridian Health Plan", "label": "Meridian Health Plan" },
        { "value": "Cascade Mutual", "label": "Cascade Mutual" },
        { "value": "Northwind Care", "label": "Northwind Care" },
        { "value": "Brightline Benefits", "label": "Brightline Benefits" }
      ]
    },
    {
      "id": "submitted",
      "kind": "date-range",
      "label": "Submitted",
      "field": "submitted_at",
      "defaultValue": { "from": "2026-08-01", "to": "2026-08-31" }
    },
    {
      "id": "claim",
      "kind": "search",
      "label": "Claim",
      "field": "claim_id",
      "placeholder": "Search claim ids"
    }
  ],
  "widgets": [
    {
      "id": "billed",
      "kind": "metric",
      "title": "Billed (cents)",
      "layout": { "colSpan": 3, "rowSpan": 1 },
      "value": { "field": "amount_cents", "aggregate": "sum" },
      "format": { "style": "compact" }
    },
    {
      "id": "claim-count",
      "kind": "metric",
      "title": "Claims",
      "layout": { "colSpan": 3, "rowSpan": 1 },
      "value": { "field": "claim_id", "aggregate": "count" }
    },
    {
      "id": "line-items",
      "kind": "metric",
      "title": "Line items per claim",
      "layout": { "colSpan": 3, "rowSpan": 1 },
      "value": { "field": "line_items", "aggregate": "avg" },
      "format": { "style": "plain", "decimals": 1 }
    },
    {
      "id": "largest-claim",
      "kind": "metric",
      "title": "Largest claim (cents)",
      "layout": { "colSpan": 3, "rowSpan": 1 },
      "value": { "field": "amount_cents", "aggregate": "max" },
      "format": { "style": "compact" }
    },
    {
      "id": "billed-by-day",
      "kind": "chart",
      "title": "Billed by day",
      "layout": { "colSpan": 8, "rowSpan": 2 },
      "chartType": "line",
      "x": { "field": "submitted_at", "bucket": "day" },
      "series": [{ "field": "amount_cents", "aggregate": "sum", "label": "Billed" }]
    },
    {
      "id": "claims-by-payer",
      "kind": "chart",
      "title": "Claims by payer",
      "layout": { "colSpan": 4, "rowSpan": 2 },
      "chartType": "bar",
      "x": { "field": "payer" },
      "series": [{ "field": "claim_id", "aggregate": "count", "label": "Claims" }]
    },
    {
      "id": "recent-claims",
      "kind": "table",
      "title": "Recent claims",
      "layout": { "colSpan": 12, "rowSpan": 2 },
      "columns": [
        { "field": "claim_id", "label": "Claim" },
        { "field": "submitted_at", "label": "Submitted" },
        { "field": "payer", "label": "Payer" },
        { "field": "status", "label": "Status" },
        {
          "field": "amount_cents",
          "label": "Amount (cents)",
          "align": "right",
          "format": { "style": "plain", "decimals": 0 }
        }
      ],
      "pageSize": 10,
      "sort": { "field": "submitted_at", "direction": "desc" }
    },
    {
      "id": "reading-note",
      "kind": "text",
      "title": "How to read this",
      "layout": { "colSpan": 12, "rowSpan": 1 },
      "body": "Figures cover the selected filters only. A widget that cannot reach its data says so on the tile instead of showing a stale number.",
      "tone": "note"
    }
  ]
}
